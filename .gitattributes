# 强制文本文件用 LF 换行
# Windows 默认 CRLF 会导致 YAML/plist 在 macOS runner 上解析异常

* text=auto eol=lf

*.swift      text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.plist      text eol=lf
*.py         text eol=lf
*.sh         text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.pem        text eol=lf
*.txt        text eol=lf
*.entitlements text eol=lf

# 二进制文件不转换
*.png        binary
*.jpg        binary
*.ico        binary
*.xcarchive  binary
*.ipa        binary
*.p12        binary
*.dSYM/      binary

# Resources 里这些是数据文件，保持原样
ios/NetaL/Resources/Assets.xcassets/** binary